# Copy to .env and adjust before running docker compose.
# Never commit the real .env file.

# Public port for the whole stack (nginx serves the UI and proxies the API)
WEB_PORT=8080

# Change this before deploying anywhere public
DB_PASSWORD=rootpassword
DB_NAME=students_db

# API tuning
LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=60

# Optional HTTPS profile: set these and run
#   docker compose --profile tls up -d --build
DOMAIN=localhost
